int totalNotas[5] = {
  sizeof(notasMusica1) / sizeof(int),
  sizeof(notasMusica2) / sizeof(int),
  sizeof(notasMusica3) / sizeof(int),
  sizeof(notasMusica4) / sizeof(int),
  sizeof(notasMusica5) / sizeof(int)
};

char nomes[5][17] = {
  "SUPER MARIO", "PALLET TOWN", "MEGALOVANIA", "SONG OF STORMS", "SWEDEN"
};

int pegarNota() {
  if (musica == 1) return pgm_read_word(&notasMusica1[notaAtual]);
  if (musica == 2) return pgm_read_word(&notasMusica2[notaAtual]);
  if (musica == 3) return pgm_read_word(&notasMusica3[notaAtual]);
  if (musica == 4) return pgm_read_word(&notasMusica4[notaAtual]);
  return pgm_read_word(&notasMusica5[notaAtual]);
}

int pegarDuracao() {
  if (musica == 1) return pgm_read_word(&duracoesMusica1[notaAtual]);
  if (musica == 2) return pgm_read_word(&duracoesMusica2[notaAtual]);
  if (musica == 3) return pgm_read_word(&duracoesMusica3[notaAtual]);
  if (musica == 4) return pgm_read_word(&duracoesMusica4[notaAtual]);
  return pgm_read_word(&duracoesMusica5[notaAtual]);
}

void reiniciarMusica() {
  noTone(buzzer);
  notaAtual = 0;
  notaIniciada = false;
}

void mostrarTela() {
  lcd.clear();
  lcd.setCursor(0, 0);
  if (noMenu == true) {
    lcd.print("MENU DE MUSICAS");
    lcd.setCursor(0, 1);
    lcd.print("Botao: ouvir som");
  } else {
    lcd.print("Musica ");
    lcd.print(musica);
    lcd.print(" de 5");
    lcd.setCursor(0, 1);
    lcd.print(nomes[musica - 1]);
  }
}

void tocarMusica() {
  if (noMenu == true || tocando == false) return;

  if (notaIniciada == false) {
    int frequencia = pegarNota();
    duracaoNota = pegarDuracao();
    if (frequencia == 0) noTone(buzzer);
    else tone(buzzer, frequencia);
    inicioNota = millis();
    notaIniciada = true;
  }

  if (millis() - inicioNota >= duracaoNota) {
    noTone(buzzer);
    notaAtual++;
    if (notaAtual >= totalNotas[musica - 1]) notaAtual = 0;
    notaIniciada = false;
  }
}

void setup() {
  lcd.begin(16, 2);
  pinMode(botaoMenu, INPUT_PULLUP);
  pinMode(botaoAvancar, INPUT_PULLUP);
  pinMode(botaoVoltar, INPUT_PULLUP);
  pinMode(botaoPlay, INPUT_PULLUP);
  pinMode(ledVermelho, OUTPUT);
  pinMode(ledVerde, OUTPUT);
  pinMode(buzzer, OUTPUT);
  mostrarTela();
}

void loop() {
  int menuAgora = digitalRead(botaoMenu);
  int avancarAgora = digitalRead(botaoAvancar);
  int voltarAgora = digitalRead(botaoVoltar);
  int playAgora = digitalRead(botaoPlay);

  if (menuAgora == LOW && antesMenu == HIGH) {
    noMenu = !noMenu;
    tocando = false;
    reiniciarMusica();
    mostrarTela();
  }

  if (noMenu == false) {
    if (avancarAgora == LOW && antesAvancar == HIGH) {
      musica++;
      if (musica > 5) musica = 1;
      reiniciarMusica();
      mostrarTela();
    }

    if (voltarAgora == LOW && antesVoltar == HIGH) {
      musica--;
      if (musica < 1) musica = 5;
      reiniciarMusica();
      mostrarTela();
    }

    if (playAgora == LOW && antesPlay == HIGH) {
      tocando = true;
    }
  }

  tocarMusica();

  if (noMenu == true) {
    digitalWrite(ledVerde, LOW);
    digitalWrite(ledVermelho, LOW);
  } else if (tocando == true) {
    digitalWrite(ledVerde, HIGH);
    digitalWrite(ledVermelho, LOW);
  } else {
    digitalWrite(ledVerde, LOW);
    digitalWrite(ledVermelho, HIGH);
  }

  antesMenu = menuAgora;
  antesAvancar = avancarAgora;
  antesVoltar = voltarAgora;
  antesPlay = playAgora;
  delay(20);
}
