
#include <LiquidCrystal.h>

LiquidCrystal lcd(2, 3, 4, 5, 6, 7);

int ledVermelho = 8;
int ledVerde = 9;
int botaoTeste = 10;
int buzzer = A0;
int botaoAvancar = 11;
int botaoVoltar = 12;
int botaoMenu = 13;

int musica = 1;
bool noMenu = true;
int antesAvancar = HIGH;
int antesVoltar = HIGH;
int antesMenu = HIGH;
int antesTeste = HIGH;
bool testeAtivo = false;
unsigned long inicioTeste = 0;

char nomes[5][17] = {
  "SUPER MARIO", "PALLET TOWN", "MEGALOVANIA", "SONG OF STORMS", "SWEDEN"
};

void mostrarTela() {
  lcd.clear();
  lcd.setCursor(0, 0);

  if (noMenu == true) {
    lcd.print("MENU DE MUSICAS");
    lcd.setCursor(0, 1);
    lcd.print("Botao: ouvir som");
  } else {
    lcd.print("Musica ");
    lcd.print(musica);
    lcd.print(" de 5");
    lcd.setCursor(0, 1);
    lcd.print(nomes[musica - 1]);
  }
}

void setup() {
  lcd.begin(16, 2);
  pinMode(botaoAvancar, INPUT_PULLUP);
  pinMode(botaoVoltar, INPUT_PULLUP);
  pinMode(botaoMenu, INPUT_PULLUP);
  pinMode(botaoTeste, INPUT_PULLUP);
  pinMode(ledVermelho, OUTPUT);
  pinMode(ledVerde, OUTPUT);
  pinMode(buzzer, OUTPUT);
  mostrarTela();
}

void loop() {
  int menuAgora = digitalRead(botaoMenu);
  int avancarAgora = digitalRead(botaoAvancar);
  int voltarAgora = digitalRead(botaoVoltar);
  int testeAgora = digitalRead(botaoTeste);

  if (menuAgora == LOW && antesMenu == HIGH) {
    noMenu = !noMenu;
    testeAtivo = false;
    noTone(buzzer);
    mostrarTela();
  }

  if (noMenu == false) {
    if (avancarAgora == LOW && antesAvancar == HIGH) {
      musica++;
      if (musica > 5) musica = 1;
      mostrarTela();
    }

    if (voltarAgora == LOW && antesVoltar == HIGH) {
      musica--;
      if (musica < 1) musica = 5;
      mostrarTela();
    }
  }

  if (noMenu == false && testeAgora == LOW && antesTeste == HIGH) {
    tone(buzzer, 440);
    inicioTeste = millis();
    testeAtivo = true;
  }

  if (testeAtivo == true && millis() - inicioTeste >= 300) {
    noTone(buzzer);
    testeAtivo = false;
  }

  if (noMenu == true) {
    digitalWrite(ledVerde, LOW);
    digitalWrite(ledVermelho, LOW);
  } else if (testeAtivo == true) {
    digitalWrite(ledVerde, HIGH);
    digitalWrite(ledVermelho, LOW);
  } else {
    digitalWrite(ledVerde, LOW);
    digitalWrite(ledVermelho, HIGH);
  }

  antesTeste = testeAgora;
  antesMenu = menuAgora;
  antesAvancar = avancarAgora;
  antesVoltar = voltarAgora;
  delay(20);
}
